{
	"name": "@fate-core/mod-types",
	"version": "0.1.2",
	"description": "Shared TypeScript types and runtime helpers for FATE: Core mods — the single source of truth for the mod manifest/bundle shape, consumed by both the app and community mod authors.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Stanislavsonder/fate-core.git",
		"directory": "packages/mod-types"
	},
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./registry.schema.json": "./registry.schema.json"
	},
	"files": [
		"dist",
		"registry.schema.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./registry.schema.json": "./registry.schema.json"
		}
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	}
}
